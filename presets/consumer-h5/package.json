{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm run dev:h5",
    "dev:h5": "uni -p h5",
    "dev:h5:host": "uni -p h5 --host 0.0.0.0",
    "build": "pnpm run build:h5",
    "build:h5": "uni build -p h5",
    "preview": "pnpm run preview:h5",
    "preview:h5": "vite preview --outDir dist/build/h5 --host 127.0.0.1 --port 4173",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.cjs,.mjs",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:dev-ready": "node tests/e2e/dev-ready.mjs",
    "test:runtime": "playwright test",
    "test:interaction": "playwright test --grep @interaction",
    "test:visual": "playwright test tests/e2e/visual.spec.mjs",
    "test:visual:update": "playwright test tests/e2e/visual.spec.mjs --update-snapshots",
    "harness:inspect": "fe-harness inspect",
    "harness:doctor": "fe-harness doctor",
    "harness:quick": "fe-harness verify quick",
    "harness:feature": "fe-harness verify feature",
    "harness:runtime": "fe-harness verify runtime",
    "harness:interaction": "fe-harness verify interaction",
    "harness:visual": "fe-harness verify visual",
    "harness:audit": "fe-harness verify audit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "vue": "3.4.21",
    "vue-i18n": "9.1.10"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.28",
    "@dcloudio/uni-cli-shared": "3.0.0-5000720260410001",
    "@dcloudio/uni-stacktracey": "3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@playwright/test": "1.62.1",
    "@vue/runtime-core": "3.4.21",
    "eslint": "8.57.1",
    "prettier": "3.8.1",
    "typescript": "5.5.4",
    "vite": "5.2.8",
    "vue-tsc": "2.2.12"
  }
}
