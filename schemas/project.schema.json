{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fe-harness/project.schema.json",
  "title": "fe-harness project configuration",
  "type": "object",
  "required": ["harness", "project", "stack", "commands", "verify"],
  "properties": {
    "harness": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "product_type", "platforms"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "product_type": {
          "type": "string",
          "enum": ["consumer_h5", "developer_tooling"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["web_mobile", "node"] }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "enum": ["uni-app", "node-esm"] }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "verify": {
      "type": "object",
      "required": ["quick", "feature", "audit"]
    }
  }
}
